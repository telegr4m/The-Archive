# Optional: enables the final Brave Image Search fallback for missing covers.
# Copy this file to .env.local and add your own key. Never commit the real key.
BRAVE_SEARCH_API_KEY=

# Server-only Supabase credentials for the persistent footer view counter.
# Never prefix either variable with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy projects may use this instead of SUPABASE_SECRET_KEY:
SUPABASE_SERVICE_ROLE_KEY=
